{
 "_readme": {
  "what": "Global mean sea level relative to present, 300 ka to 0. This is the curve that generates every paleo-coastline in the film: one bathymetry raster thresholded against seaLevel(t).",
  "law01": "Read-only input to t. Nothing here is authored; every number came out of a published dataset.",
  "units": "kaBP = thousands of calendar years before present (1950). m = metres relative to present sea level. lo/hi = 95% confidence bounds. sd = bootstrap standard deviation.",
  "resolution": "1 ka. Adequate for beats 01-08. NOT adequate for the deglacial, which is where the film's most dramatic sea-level motion happens - see deglacialOverride.",
  "provenance": "Downloaded 2026-09-04 from NOAA/WDS Paleoclimatology, unmodified. Column SeaLev_shortPC1 (scaled first principal component of seven reconstructions, 0-430 ka).",
  "warning": "The stack reads +8.49 m at 0 ka. That is a stack artifact - smoothing plus the scaling procedure - not a real present-day highstand. Do NOT feed the raw series into the shader for the last 20 ka. Splice the deglacial override over it, or the film will show the modern coastline drowned."
 },
 "source": {
  "cite": "Spratt, R. M. & Lisiecki, L. E. (2016). A Late Pleistocene sea level stack. Climate of the Past 12, 1079-1092.",
  "doi": "10.5194/cp-12-1079-2016",
  "data": "https://www.ncei.noaa.gov/pub/data/paleo/contributions_by_author/spratt2016/spratt2016.txt",
  "dataDoi": "10.25921/RD66-5820",
  "checked": "web-2026-09-04",
  "note": "PCA stack of seven sea level reconstructions. Mean uncertainty 9-12 m (1 sigma). Agrees to within 5 m with isostatically adjusted coral estimates at MIS 5e and 11."
 },
 "deglacialOverride": {
  "why": "Beats 08 through 12 - the freeze, the mammoth steppe, the sweep, the doors closing - all turn on sea level between 26 ka and 7 ka. Spratt is too coarse there and its Holocene end is wrong. Lambeck et al. 2014 is the reference curve for this window and must be spliced in before any of those beats is built.",
  "required": "Lambeck, K. et al. (2014). Sea level and global ice volumes from the Last Glacial Maximum to the Holocene. PNAS 111, 15296-15303. Data in the PNAS supplementary information - not yet acquired.",
  "verifiedAnchors": [
   {
    "kaBP": 29.0,
    "m": -134,
    "note": "Slow fall to the lowstand begins",
    "source": "lambeck2014"
   },
   {
    "kaBP": 21.0,
    "m": -134,
    "note": "Lowstand. Maximum grounded ice volume ~52e6 km3. GIA-corrected direct measurements give -130 to -134 m.",
    "source": "lambeck2014"
   },
   {
    "kaBP": 14.65,
    "m": -96,
    "note": "MWP-1A begins. Value approximate pending Lambeck SI.",
    "source": "deschamps2012"
   },
   {
    "kaBP": 14.31,
    "m": -80,
    "note": "MWP-1A ends. Rise of 12-22 m, most probable 14-18 m, in under 350 years. The fastest water moves in the film.",
    "source": "deschamps2012"
   },
   {
    "kaBP": 0.0,
    "m": 0,
    "note": "Present, by definition",
    "source": "definition"
   }
  ],
  "status": "INCOMPLETE. The two MWP-1A depths are interpolated to bracket a rise of the published magnitude; they are not Lambeck values. Flagged so nobody mistakes them for sourced numbers."
 },
