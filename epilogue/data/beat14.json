{
 "_readme": "Built from timeline.json and data/. Do not edit by hand.",
 "beat": {
  "id": 14,
  "act": 4,
  "slug": "human-web",
  "title": "The human web",
  "yearsBP": [
   800,
   0
  ],
  "scrollWeight": 7,
  "motion": 2,
  "tentpole": true,
  "onScreen": "In the last five hundred years, migration took on another form: empire, enslavement, expulsion, labour, and flight. Millions moved because they were forced to move. Follow any family story far enough back, and it stops being a single line. It opens into a vast human web. Each of us carries a different path through the same deep past.",
  "events": [
   "colonial-forced-migration",
   "generation-depth",
   "ancestral-fan"
  ],
  "onScreenNote": "The forced-movement bridge and the fan are one final sequence. The fan does not trace one line back to Africa; it shows overlapping paths and makes room for every family history."
 },
 "events": [
  {
   "id": "colonial-forced-migration",
   "beat": 14,
   "type": "dispersal",
   "label": "The last five hundred years",
   "region": "global",
   "coordinates": null,
   "dateRange": [
    450,
    0
   ],
   "dateNote": "Transatlantic slave trade 1501-1867: about 12.5 million people embarked, about 10.7 million landed. Plus colonial settlement, indentured labour, industrial migration and modern displacement.",
   "confidence": "solid",
   "sourceIds": [
    "slavevoyages"
   ],
   "why": "ADDED, AND LOAD-BEARING. The film previously claimed 300,000 BP to now while stopping at 1021 CE, which left the largest forced migration in history inside a silent gap. Ending on 'here is your line back to Africa' while saying nothing about the last 500 years is not a scope problem, it breaks the ending - for millions of viewers that line is not a story of frontier.\n\nNOT A BEAT AND NOT A DISCLAIMER. It is a 20-30 second bridge in the transition from 1300 CE to now, which the film has to make anyway. Movement of a completely different character: dense, directed, not chosen. One line. No number on screen."
  },
  {
   "id": "generation-depth",
   "beat": 14,
   "type": "derived",
   "label": "Generations since the dispersal",
   "region": "—",
   "coordinates": null,
   "dateRange": null,
   "dateNote": "RESOLVED with a real citation. Wang et al. 2023 give a mean human generation interval of 26.9 ± 3.4 years across the past 250,000 years. At a ~50 ka dispersal that is ~1,860 generations. On screen: 'roughly two thousand'. Computed at build time from ooa-dispersal, never hardcoded.",
   "confidence": "supported",
   "sourceIds": [
    "sumer2024",
    "wang2023"
   ],
   "why": "The last line of the film. Must be derived from ooa-dispersal and the generation interval at build time, never hardcoded — if the dispersal date moves, this moves."
  },
  {
   "id": "ancestral-fan",
   "beat": 14,
   "type": "derived",
   "label": "The fan",
   "region": "global",
   "coordinates": null,
   "dateRange": null,
   "dateNote": "Ancestor count doubles each generation until it exceeds every human who has ever lived, so ancestral lines must fold back on each other. Everyone's ancestry fans out and then merges.",
   "confidence": "solid",
   "sourceIds": [
    "wang2023"
   ],
   "why": "REPLACES THE SINGLE LINE. Drawing one thread from the viewer back to Africa is false for everyone and especially wrong for anyone of African or mixed ancestry.\n\nTHE SHOT: start with one line - intimate, personal, the mirror intact. As the camera pulls back through the beats it splits: two, four, eight, widening. Then in the deep past it stops widening and starts MERGING, because the lines run out of separate people to belong to. It converges on Africa. Then the reveal: the same fan is the fan of the person sitting next to you.\n\nMore accurate AND a better image. And it dissolves the exclusion problem - if your ancestry is entirely African, your fan simply never leaves, and it is still the same fan. Geolocation stays optional; the shot must work when it is declined."
  }
 ],
 "sources": {
  "slavevoyages": {
   "cite": "Eltis, D. & Richardson, D. Voyages: The Trans-Atlantic Slave Trade Database. Data on ~35,000 voyages, 1501-1867.",
   "checked": "web-2026-09-04",
   "note": "About 12.5 million people embarked in Africa; about 10.7 million landed. The largest forced migration in history. No number goes on screen in the bridge - the line carries it without one."
  },
  "sumer2024": {
   "cite": "Sümer, A. P. et al. (2024). Earliest modern human genomes constrain timing of Neanderthal admixture. Nature 638.",
   "checked": "web-2026-09-04",
   "note": "The single most consequential source in this file. It moved the dispersal date, moved the admixture into beat 05, and put Madjedbebe under pressure."
  },
  "wang2023": {
   "cite": "Wang, R. J. et al. (2023). Human generation times across the past 250,000 years. Science Advances 9, eabm7047.",
   "checked": "web-2026-09-04",
   "note": "Mean generation interval 26.9 ± 3.4 yr (male 30.7, female 23.2). Peaked at 29.8 yr around 38 ka; minimum of 24.9 yr around 6.4 ka."
  }
 },
